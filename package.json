{
  "name": "dsh-drama-desk",
  "version": "0.1.0",
  "description": "AI 短剧生产流水线的工作台：流水线网格、镜详情、规范契约、资产与台账",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "AGENTS.md",
    "README.md",
    "src/host",
    "src/tools",
    "src/spec",
    "build/skills",
    "build/spec",
    "build/tools",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "pack": "node scripts/pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "drama",
    "storyboard",
    "pipeline"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  }
}
